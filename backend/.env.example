# MediKiosk Backend Environment Variables
# Copy to .env and fill in values

# Supabase (pre-configured in Bolt environment)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=your_db_url

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Cache
CACHE_TTL=300

# Redis (optional - for production caching)
# REDIS_URL=redis://localhost:6379

# Bhashini ASR (for voice processing)
# BHASHINI_API_KEY=your_bhashini_key
# BHASHINI_ENDPOINT=https://bhashini.gov.in/api

# OCR (for document scanning)
# OCR_API_KEY=your_ocr_key
